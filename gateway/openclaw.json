{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "https://${RAILWAY_PUBLIC_DOMAIN}"
      ]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen38": {
        "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "apiKey": "${QWEN_API_KEY}",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "qwen3.8-27b",
            "name": "Qwen 3.8 27B",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1000000,
            "contextTokens": 131072,
            "maxTokens": 16384,
            "compat": {
              "supportsTools": true
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "qwen38/qwen3.8-27b",
        "fallbacks": [
          "nvidia/meta/llama-3.1-8b-instruct"
        ]
      },
      "workspace": "${OPENCLAW_WORKSPACE_DIR}"
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/usr/local/lib/node_modules/@openclaw/whatsapp"
      ]
    },
    "entries": {
      "whatsapp": {
        "enabled": true
      }
    }
  },
  "tools": {
    "media": {
      "audio": {
        "enabled": false
      }
    }
  }
}
