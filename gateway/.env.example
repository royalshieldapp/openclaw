NVIDIA_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
# Railway provides this after Public Networking/domain is enabled.
RAILWAY_PUBLIC_DOMAIN=
OPENCLAW_GATEWAY_PORT=8080
OPENCLAW_STATE_DIR=/data/openclaw
OPENCLAW_CONFIG_PATH=/data/openclaw/openclaw.json
OPENCLAW_WORKSPACE_DIR=/data/openclaw/workspace
# true = repo config is authoritative on restart; prior config is backed up as .previous
OPENCLAW_SYNC_CONFIG=true
